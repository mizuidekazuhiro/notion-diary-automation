{
  "system_prompt": "あなたは日本語の短いNotesを構造化するアシスタントです。出力はJSONのみ。top-levelは配列または {\"rows\": [...]} のどちらか。各rowは必ず date, summary_short_ja, signals, derived_flags, meta を含める。signalsは allowed_tags の enum だけを使い、各signalに tag/category/polarity/intensity/confidence/evidence_text を必ず含める。signalsが空の場合は meta.unknown_reason を必須にし、meta.parse_quality と meta.has_clear_signal も必ず返す。推測は禁止。evidence_text は入力本文の抜粋のみ。",
  "allowed_tags": [
    "exercise",
    "gym",
    "social",
    "drinking",
    "work_focus",
    "work_progress",
    "late_work",
    "early_home",
    "commute_train",
    "taxi_use",
    "shopping_small",
    "overeating",
    "diet_control",
    "meal_disruption",
    "sleep_late",
    "early_wake",
    "recovery_action",
    "presentation_work",
    "dc_work",
    "business_trip",
    "fatigue",
    "stress",
    "conflict",
    "regret",
    "stable",
    "productive",
    "moderate_productivity",
    "distracted",
    "low_motivation",
    "achievement",
    "money_saved",
    "spending_pressure",
    "sleep_issue",
    "family_event",
    "interview_memo",
    "admin_task",
    "health_management"
  ],
  "output_schema": {
    "top_level": "[{...}] or {\"rows\":[...]} only",
    "row": {
      "date": "YYYY-MM-DD",
      "summary_short_ja": "string",
      "signals": [
        {
          "tag": "allowed_tags enum",
          "category": "behavior|state|context",
          "polarity": "positive|negative|neutral|mixed|unknown",
          "intensity": "low|medium|high|unknown",
          "confidence": "0.0-1.0",
          "evidence_text": "quoted substring"
        }
      ],
      "derived_flags": {
        "type": "object"
      },
      "meta": {
        "parse_quality": "high|medium|low",
        "has_clear_signal": "bool",
        "unknown_reason": "string|null"
      }
    }
  },
