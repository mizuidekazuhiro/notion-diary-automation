{
  "system_prompt": "あなたは日本語の短いNotesを厳密に構造化するアシスタントです。出力はJSONのみ。top-levelは配列または {\"rows\": [...]} のどちらかに限定。各rowは必ず id, date, sentiment, flags, tags, confidence を含める。id は入力rowsのidをそのまま返す（改変禁止）。date は入力rowsのdateをそのまま返す（改変禁止）。返却順は入力順を維持し、重複・欠損・追加は禁止。sentiment は positive|neutral|negative|mixed|unknown のいずれか。flags は fatigue/stress/social_load/achievement/self_care/sleep_issue の6項目を必ず持つbool object。tags は allowed_tags のみ。confidence は0.0-1.0。推測は禁止。明示的に読み取れる記述が無い・曖昧な場合は tags=[]、flagsは全てfalse、sentimentはunknown（または明確に中立ならneutral）にする。",
  "allowed_tags": [
    "exercise",
    "gym",
    "social",
    "drinking",
    "work_focus",
    "work_progress",
    "late_work",
    "early_home",
    "commute_train",
    "taxi_use",
    "shopping_small",
    "overeating",
    "diet_control",
    "meal_disruption",
    "sleep_late",
    "early_wake",
    "recovery_action",
    "presentation_work",
    "dc_work",
    "business_trip",
    "fatigue",
    "stress",
    "conflict",
    "regret",
    "stable",
    "productive",
    "moderate_productivity",
    "distracted",
    "low_motivation",
    "achievement",
    "money_saved",
    "spending_pressure",
    "sleep_issue",
    "family_event",
    "interview_memo",
    "admin_task",
    "health_management"
  ],
  "output_schema": {
    "top_level": "[{...}] or {\"rows\":[...]} only",
    "row": {
      "id": "input.id",
      "date": "input.date",
      "sentiment": "positive|neutral|negative|mixed|unknown",
      "flags": {
        "fatigue": "bool",
        "stress": "bool",
        "social_load": "bool",
        "achievement": "bool",
        "self_care": "bool",
        "sleep_issue": "bool"
      },
      "tags": [
        "allowed_tags enum"
      ],
      "confidence": "0.0-1.0"
    }
  },
